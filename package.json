{
  "name": "pigeon",
  "version": "0.1.23",
  "description": "A reference-first visual asset library for files that stay where they are.",
  "main": "electron/main.js",
  "author": "Pigeon",
  "license": "MIT",
  "homepage": "https://github.com/vcsoc/pigeon",
  "desktopName": "pigeon.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke-test",
    "smoke:seeded": "electron . --smoke-test --smoke-seeded",
    "smoke:large": "electron . --smoke-test --smoke-large",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/database.js && node --check electron/database-worker.js && node --check electron/library-worker.js && node --check electron/scan-worker.js && node --check electron/folder-tree-worker.js && node --check electron/pdf-thumbnail-worker.js && node --check electron/pdf-thumbnail-child.js && node --check electron/library-core.js && node --check electron/plugin-worker.js && node --check src/renderer.js",
    "test": "node --test --test-timeout=19000 tests/*.test.js",
    "verify": "npm run check && npm test && npm run smoke:seeded",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "exif-reader": "^2.0.3",
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "cool.pigeon.app",
    "productName": "Pigeon",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "vcsoc",
        "repo": "pigeon"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "browser-extension/**/*",
      "pigeon-logo.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Pigeon Local Capture",
        "schemes": [
          "pigeon"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "pigeon-logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Pigeon-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "pigeon-logo.png",
      "executableName": "Pigeon"
    },
    "nsis": {
      "artifactName": "Pigeon-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Pigeon-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Graphics",
      "icon": "pigeon-logo.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "pigeon",
      "artifactName": "Pigeon-${version}-linux-${arch}.${ext}",
      "maintainer": "Pigeon",
      "syncDesktopName": true
    }
  }
}
