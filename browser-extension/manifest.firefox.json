{
  "manifest_version": 3,
  "name": "Pigeon for Firefox",
  "version": "2.2.0",
  "description": "Download media or the highest-quality YouTube thumbnail with source links, format, quality, and chapter options.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["service-worker.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["drop-url.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Pigeon Downloads",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "drag-drop@pigeon.cool",
      "strict_min_version": "109.0"
    }
  }
}
