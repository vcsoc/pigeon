{
  "manifest_version": 3,
  "name": "Pigeon Local Capture",
  "version": "1.0.0",
  "description": "Send images, videos, and page URLs to the local Pigeon library.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Pigeon" }
}
