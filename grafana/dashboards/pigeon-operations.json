{
  "uid": "pigeon-operations",
  "title": "Pigeon - Operations and Traces",
  "tags": [
    "pigeon",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Average duration by operation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(pigeon_operation_duration_milliseconds_sum{service_name=\"pigeon-desktop\"}[5m])) / clamp_min(sum by (operation) (rate(pigeon_operation_duration_milliseconds_count{service_name=\"pigeon-desktop\"}[5m])), 0.000001)",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "Average duration of recorded operations; no data is expected between infrequent operations."
    },
    {
      "id": 2,
      "title": "Operation p95 duration",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(pigeon_operation_duration_milliseconds_bucket{service_name=\"pigeon-desktop\"}[5m])))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Diagnostic events by severity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (increase(pigeon_diagnostics_total{service_name=\"pigeon-desktop\"}[1h]))",
          "legendFormat": "{{severity}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Rolling one-hour count, split by severity."
    },
    {
      "id": 4,
      "title": "Memory over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (pigeon_process_memory_bytes{service_name=\"pigeon-desktop\"})",
          "legendFormat": "{{kind}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Recent Pigeon traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pigeon-desktop\" }",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Selected IPC operations, startup and bounded performance spans. Open Tempo Explore to inspect trace details."
    },
    {
      "id": 6,
      "title": "Pigeon diagnostic log stream",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"pigeon-desktop\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Diagnostic details and file paths are not sent to the collector."
    }
  ],
  "links": [
    {
      "title": "Pigeon overview",
      "type": "link",
      "url": "/d/pigeon-overview/pigeon-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
